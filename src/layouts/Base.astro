---
import '../styles/global.css';
import {copy, pages} from '../data/content.js';
const {lang='ja', page='home'} = Astro.props;
const c = copy[lang];
const base=import.meta.env.BASE_URL;
const url=(l,p)=>`${base}${l}/${p==='home'?'':p+'/'} ` .trim();
const other=lang==='ja'?'en':'ja';
const name={home:'Iwashita Laboratory',research:c.researchTitle,publications:c.pubsTitle,members:c.membersTitle,news:c.newsTitle,contact:c.contactTitle}[page];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={c.subtitle}/><meta name="theme-color" content="#0a1724"/><title>{name} | Oita University</title><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/></head>
<body><header class="header"><div class="container nav"><a href={url(lang,'home')} class="brand"><span class="brand-symbol">I<span>.</span></span><span class="brand-name">IWASHITA <small>LABORATORY</small></span></a><nav aria-label="Main navigation">{pages.map((p,i)=><a class:list={[{active:p===page}]} href={url(lang,p)}>{c.nav[i]}</a>)}</nav><a class="language" href={url(other,page)} aria-label="Switch language">{c.langLabel} <span>↗</span></a></div></header>
<main><slot/></main><footer><div class="container footer-inner"><strong>{c.footer}</strong><p>{c.notice}</p><small>© {new Date().getFullYear()} Iwashita Laboratory</small></div></footer></body></html>
