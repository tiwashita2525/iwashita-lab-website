---
import Base from '../../layouts/Base.astro';
import ContactDetails from '../../components/ContactDetails.astro';
import MembersList from '../../components/MembersList.astro';
import NewsList from '../../components/NewsList.astro';
import PublicationsList from '../../components/PublicationsList.astro';
import ResearchDetailGrid from '../../components/ResearchDetailGrid.astro';
import SelectedPublications from '../../components/SelectedPublications.astro';
import {copy} from '../../data/content.js';
import {contactPageCopy} from '../../data/contact.js';
import {memberPageCopy} from '../../data/members.js';
export function getStaticPaths(){return ['ja','en'].flatMap(lang=>['research','publications','members','news','contact'].map(page=>({params:{lang,page}})))}
const {lang,page}=Astro.params;
const c=copy[lang];
const contentKey=page==='publications'?'pubs':page;
const title=c[contentKey+'Title'];
const lead=c[contentKey+'Lead'];
const pageLead=page==='research'
  ? c.researchPageLead
  : page==='publications'
  ? ''
  : page==='members'
    ? memberPageCopy[lang].lead
  : page==='contact'
    ? contactPageCopy[lang].lead
  : lead;
---
<Base lang={lang} page={page}><section class="subhero"><div class="container"><div class="label">TI Lab / {page.toUpperCase()}</div><h1>{title}</h1>{pageLead && <p>{pageLead}</p>}</div></section><section class="container section">
{page==='research' ? <><ResearchDetailGrid lang={lang} items={c.researchDetails}/><SelectedPublications lang={lang}/></> : page==='publications' ? <PublicationsList lang={lang}/> : page==='members' ? <MembersList lang={lang}/> : page==='news' ? <NewsList lang={lang}/> : page==='contact' ? <ContactDetails lang={lang}/> : <div class="pending"><span class="pending-dash"/><h2>{c.placeholder}</h2><p>{lead}</p></div>}
</section></Base>
