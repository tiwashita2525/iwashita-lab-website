---
import {getPublicationTitle, getPublicationVenue, publications} from '../data/publications.js';
import {selectedPublicationGroups} from '../data/selectedPublications.js';

const {lang = 'ja'} = Astro.props;
const text = lang === 'ja' ? {
  heading: '主な研究成果',
  doi: 'DOI',
  japaneseNote: '（日本語）',
} : {
  heading: 'Selected Publications',
  doi: 'DOI',
  japaneseNote: ' (in Japanese)',
};
const getText = (item, key) => typeof item[key] === 'string' ? item[key].trim() : '';
const publicationById = new Map(publications.map(publication => [publication.id, publication]));
const groups = selectedPublicationGroups.map(group => ({
  ...group,
  publications: group.publicationIds.map(id => {
    const publication = publicationById.get(id);
    if (!publication) {
      throw new Error(`Selected publication not found: ${id}`);
    }

    return {
      id,
      title: getPublicationTitle(publication, lang),
      venue: getPublicationVenue(publication, lang),
      year: publication.year,
      doi: getText(publication, 'doi'),
      showJapaneseNote: lang === 'en' && publication.language === 'ja',
    };
  }),
}));
---

<section class="selected-publications" aria-labelledby="selected-publications-title">
  <header class="selected-publications-head">
    <span>SELECTED PUBLICATIONS</span>
    <h2 id="selected-publications-title">{text.heading}</h2>
  </header>
  <div class="selected-publication-groups">
    {groups.map((group, groupIndex) => <article aria-labelledby={`selected-publications-${group.id}`}>
      <header class="selected-group-head">
        <span>{String(groupIndex + 1).padStart(2, '0')}</span>
        <h3 id={`selected-publications-${group.id}`}>{group.title[lang]}</h3>
      </header>
      <ol>
        {group.publications.map(publication => <li>
          <h4>{publication.title}{publication.showJapaneseNote && <span class="publication-language">{text.japaneseNote}</span>}</h4>
          <p><cite>{publication.venue}</cite><span>{publication.year}</span></p>
          {publication.doi && <a href={`https://doi.org/${publication.doi}`} rel="noreferrer">{text.doi} ↗</a>}
        </li>)}
      </ol>
    </article>)}
  </div>
</section>

<style>
  .selected-publications{margin-top:96px;padding-top:62px;border-top:1px solid #d7e3e6}
  .selected-publications-head{margin-bottom:34px}
  .selected-publications-head>span{color:#079ca6;font-size:10px;font-weight:700;letter-spacing:.18em}
  .selected-publications-head h2{margin:12px 0 0;color:#102834;font-size:clamp(28px,3vw,40px);font-weight:600;line-height:1.4;letter-spacing:-.025em}
  .selected-publication-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .selected-publication-groups article{min-width:0;padding:27px;background:#f1f5f6;border-top:3px solid #19a7ad}
  .selected-group-head{min-height:84px;padding-bottom:20px;border-bottom:1px solid #d4e1e4}
  .selected-group-head>span{display:block;color:#079ca6;font-size:10px;font-weight:700;letter-spacing:.12em}
  .selected-group-head h3{margin:10px 0 0;color:#182833;font-size:18px;line-height:1.55}
  ol{list-style:none;margin:0;padding:0}
  li{padding:22px 0;border-bottom:1px solid #d4e1e4}
  li:last-child{padding-bottom:0;border-bottom:0}
  h4{margin:0;color:#182833;font-size:14px;font-weight:600;line-height:1.65}
  .publication-language{color:#607681;font-size:.82em;font-weight:500}
  p{display:flex;flex-wrap:wrap;gap:5px 10px;margin:10px 0 0;color:#607681;font-size:11px;line-height:1.6}
  cite{font-style:normal}
  p span{color:#087c81;font-weight:700}
  a{display:inline-block;margin-top:10px;color:#087c81;font-size:11px;font-weight:700}
  @media(max-width:900px){
    .selected-publication-groups{grid-template-columns:1fr}
    .selected-group-head{min-height:0}
  }
  @media(max-width:560px){
    .selected-publications{margin-top:64px;padding-top:44px}
    .selected-publication-groups article{padding:23px}
    .selected-publications-head h2{font-size:28px}
  }
</style>
