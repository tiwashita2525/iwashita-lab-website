---
import {researchImageCopy, researchImageGroups} from '../data/researchImages.js';

const {lang = 'ja', items = []} = Astro.props;
const base = import.meta.env.BASE_URL;
const imageText = researchImageCopy[lang];
---

<div class="research-grid">
  {items.map(([no, title, desc], areaIndex) => {
    const group = researchImageGroups[areaIndex];
    return <article class="research-card research-detail-card">
      <span class="number">{no}</span>
      <h2>{title}</h2>
      <p>{desc}</p>
      <div class="research-gallery" aria-label={title}>
        {group.images.map((image, imageIndex) => <figure class:list={[{'research-gallery-wide': image.wide}]}>
          <img
            src={`${base}${image.src}`}
            width={image.width}
            height={image.height}
            alt={`${image.caption[lang]} — ${imageText.alt(title, imageIndex + 1)}`}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{image.caption[lang]}</figcaption>
        </figure>)}
      </div>
    </article>;
  })}
</div>

<style>
  .research-detail-card{min-height:0}
  .research-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:25px;padding-top:22px;border-top:1px solid #d9e4e7}
  .research-gallery figure{margin:0;min-width:0;background:#edf3f4;border:1px solid #dce8e9}
  .research-gallery img{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:contain;background:#f7f9f9}
  .research-gallery figcaption{padding:8px 10px;color:#607681;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .research-gallery-wide{grid-column:1/-1}
  .research-gallery .research-gallery-wide img{aspect-ratio:auto;object-fit:contain}
  @media(max-width:520px){
    .research-gallery{grid-template-columns:1fr}
    .research-gallery-wide{grid-column:auto}
  }
</style>
